@model IEnumerable<Tilskuddsapp.Models.GrantCase>

@{
    ViewData["Title"] = "Tilskuddssaker";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tilskuddssaker</h1>
    <div>
        <a asp-controller="GrantCases" asp-action="ExportAllToExcel" class="btn btn-success me-2">
            📊 Eksporter alle til Excel
        </a>
        <a asp-controller="GrantCases" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Opprett ny tilskuddssak
        </a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Lege</th>
            <th>År</th>
            <th>Innvilget tilskudd</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var grantCase in Model)
        {
            <tr>
                <td>@grantCase.DoctorName</td>
                <td>@grantCase.Year</td>
                <td>@grantCase.ApprovedGrant.ToString("N0") kr</td>
                <td>@grantCase.GrantCaseStatus</td>
                <td>
                    <a asp-controller="GrantCases"
                       asp-action="GrantCaseDetails"
                       asp-route-id="@grantCase.GrantCaseId"
                       class="btn btn-primary btn-sm">
                        Se detaljer
                    </a>
                    <a asp-controller="GrantCases"
                       asp-action="ExportToExcel"
                       asp-route-id="@grantCase.GrantCaseId"
                       class="btn btn-success btn-sm">
                        📊 Eksporter Excel
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
