<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tilskuddsapp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tilskuddsapp.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Gå til hovedinnhold</a>
    <header class="site-header">
        <nav class="header-nav" aria-label="Hovedmeny">
            <a class="header-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Helsedirektoratet – forsiden">
                <img src="~/images/helsedirektoratet-logo.svg" alt="Helsedirektoratet" width="260" height="34" />
            </a>
            @* Search, language and account controls are visual placeholders. *@
            <div class="header-actions">
                <a class="apply-button" asp-controller="GrantApplications" asp-action="Create">SØK HER</a>
                <button type="button" class="header-control search-button" aria-label="Søk" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4.5 4.5" /></svg>
                </button>
                <button type="button" class="header-control" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><ellipse cx="12" cy="12" rx="3.5" ry="8" /><path d="M4 12h16" /></svg>
                    <span>Språk</span>
                    <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
                </button>
                <button type="button" class="header-control account-button" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3.5" /><path d="M5 21v-3a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v3" /></svg>
                    <span>Test Test</span>
                    <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
                </button>
            </div>
        </nav>
    </header>
    <div class="container page-content">
        <main id="main-content" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Tilskuddsapp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
